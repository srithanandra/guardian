# Copy this file to .env and fill in keys you have.
# Restart `npm run dev` after changing .env.

# --- Neural voice (pick one) ---
# Azure is best for Vietnamese (HoaiMy).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus

# Used if Azure is unset.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1-hd

# Set to 0 to force the browser voice even when keys are present.
GUARDIAN_TTS=1

# --- Optional LLM guidance / dispatcher triage ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GUARDIAN_USE_LLM=1

# --- Demo timing ---
GUARDIAN_TIER_HOLD_SECONDS=8
GUARDIAN_DEMO_PING_SECONDS=1.2
GUARDIAN_AUTO_ESCALATE=1
